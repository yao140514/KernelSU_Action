# gauguin LineageOS 23.2 内核编译配置，SukiSU Ultra
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_gauguin
KERNEL_BRANCH=lineage-23.2

# SukiSU Ultra
KERNELSU_REPO=https://github.com/5ec1cff/SukiSU
KERNELSU_BRANCH=main
KERNELSU_VARIANT=sukisu-ultra

# 关闭SUSFS补丁，规避补丁冲突报错
APPLY_SUSFS=false
BACKPORT_PATH_UMOUNT=false

# 编译工具链
CLANG_REPO=https://github.com/kdrag0n/proton-clang
CLANG_BRANCH=master
CLANG_VERSION=r450784e

# 内核配置
DEFCONFIG=gauguin_defconfig
ARCH=arm64
