# gauguin LineageOS 23.2 内核编译配置 SukiSU Ultra
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_gauguin
KERNEL_SOURCE_BRANCH=lineage-23.2

# SukiSU Ultra
KERNELSU_REPO=https://github.com/5ec1cff/SukiSU
KERNELSU_BRANCH=main
KERNELSU_VARIANT=sukisu-ultra

# 关闭SUSFS补丁
APPLY_SUSFS=false
BACKPORT_SUSFS=false

# ========== 自定义Clang：proton-clang 预编译二进制仓库 ==========
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/kdrag0n/proton-clang.git
CUSTOM_CLANG_BRANCH=master
# 重点！第三方预编译clang，删除 CUSTOM_CLANG_VERSION 这一行！！

# 内核配置
KERNEL_CONFIG=gauguin_defconfig
ARCH=arm64
