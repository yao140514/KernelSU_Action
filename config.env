# KernelSU Action -- build profile
#
# Values here are defaults; workflow_dispatch inputs override them per run.
# Only the exact string "true" (or yes/on/1) counts as enabled.
#
# Copy this file to config/gauguin.env then select it in workflow run.

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_gauguin
KERNEL_SOURCE_BRANCH=lineage-23.2
KERNEL_CONFIG=vendor/sm7225_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

KERNEL_NAME=gauguin-SM7225-ReSukiSU-Full
ADD_LOCALVERSION_TO_FILENAME=false

# Extra flags appended to every make invocation.
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
KSU_VARIANT=resukisu
KSU_REF=

# SM7225 4.19 Non-GKI MUST manual hook
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# 开启 SUSFS 挂载隐藏
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# 4.19 需要 path_umount 补丁，overlay依赖
ENABLE_PATH_UMOUNT=true
# 开启指纹/属性隐藏
ENABLE_HIDE_STUFF=true
# ReSukiSU不使用KPM
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
# lineage gauguin 开启LTO容易编译失败，直接关闭
DISABLE_LTO=true
DISABLE_CC_WERROR=false

EXTRA_DEFCONFIG=CONFIG_KSU=y CONFIG_KSU_MANUAL_HOOK=y

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false

# ✅ 方案B：关闭boot.img打包，只输出AnyKernel3刷入zip
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
